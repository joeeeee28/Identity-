# Runtime
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Production persistence (required outside development)
DATABASE_URL=postgresql://smart_corp:change-me@localhost:5432/smart_corp
DATABASE_SSL=false

# Development-only session bypass. Set to false in staging/production.
DEV_AUTH_BYPASS=true
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
DEV_USER_ID=00000000-0000-0000-0000-000000000101
SESSION_SECRET=replace-with-a-long-random-secret

# Object storage / malware scanning integration boundaries.
# STORAGE_PROVIDER: local (development only) | s3 (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=smart-corp-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Force path-style addressing for MinIO and other non-AWS endpoints.
STORAGE_FORCE_PATH_STYLE=false
# MALWARE_SCANNER_PROVIDER: disabled-in-development | clamav (required in staging/production)
MALWARE_SCANNER_PROVIDER=disabled-in-development
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=30000

# AI gateway. Providers are called only by the server gateway.
# development-grounded, openai, anthropic or google
AI_PROVIDER=development-grounded
AI_MODEL=smart-corp-grounded-v1
# Comma-separated allowlist in production, e.g. gpt-5.6-terra,gpt-5.6-sol
AI_APPROVED_MODELS=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS=1200
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_API_KEY=
WEB_ALLOWED_DOMAINS=

# Operational controls
LOG_LEVEL=info
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_HOUR=20
