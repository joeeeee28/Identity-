# =============================================================================
# Smart-Corp AI — environment template (PLACEHOLDERS ONLY, no secrets).
# Copy to .env for local development; in staging/production inject real values
# via the platform secret manager (never commit them). See
# docs/STAGING_REQUIRED_INPUTS.md for exactly where to obtain each value.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

# --- PostgreSQL (REQUIRED outside development) ---
# Free staging: Neon Free (see docs/STAGING_REQUIRED_INPUTS.md).
DATABASE_URL=<YOUR_DATABASE_URL>
DATABASE_SSL=true
DATABASE_POOL_SIZE=20

# --- Identity (OIDC) ---
# Free staging: self-hosted Keycloak (docker-compose.staging.yml) or the
# pilot customer's existing IdP (Entra ID / Okta / Google). See docs.
OIDC_ISSUER=<YOUR_OIDC_ISSUER_URL>
OIDC_CLIENT_ID=<YOUR_OIDC_CLIENT_ID>
OIDC_CLIENT_SECRET=<YOUR_OIDC_CLIENT_SECRET>
OIDC_REDIRECT_URI=<YOUR_OIDC_REDIRECT_URI>
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles
OIDC_REQUIRE_MFA=false

# --- Session (password fallback path) ---
DEV_AUTH_BYPASS=true
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
DEV_USER_ID=00000000-0000-0000-0000-000000000101
SESSION_SECRET=<YOUR_SESSION_SECRET>

# --- Object storage ---
# STORAGE_PROVIDER: local (dev only) | s3 (AWS S3 / Cloudflare R2 / MinIO)
# Free staging: Cloudflare R2 (10 GB free, zero egress) — see docs.
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=<YOUR_S3_ENDPOINT>          # R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=smart-corp-documents
STORAGE_ACCESS_KEY_ID=<YOUR_S3_ACCESS_KEY_ID>
STORAGE_SECRET_ACCESS_KEY=<YOUR_S3_SECRET_ACCESS_KEY>
STORAGE_FORCE_PATH_STYLE=true

# --- Malware scanning (ClamAV, self-hosted, no external credential) ---
MALWARE_SCANNER_PROVIDER=clamav
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=30000

# --- AI gateway (providers are called server-side only) ---
# AI_PROVIDER: development-grounded | openai | anthropic | google
AI_PROVIDER=openai
AI_MODEL=<YOUR_AI_MODEL>
AI_APPROVED_MODELS=<YOUR_AI_MODEL>
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS=1200
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_AI_API_KEY=<YOUR_GOOGLE_AI_API_KEY>
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_API_KEY=
WEB_ALLOWED_DOMAINS=

# --- Enterprise connector (ONE; free developer access) ---
# Microsoft Graph (Entra ID app) or Google Workspace. See docs.
CONNECTOR_PROVIDER=<YOUR_CONNECTOR_PROVIDER>
CONNECTOR_CLIENT_ID=<YOUR_CONNECTOR_CLIENT_ID>
CONNECTOR_CLIENT_SECRET=<YOUR_CONNECTOR_CLIENT_SECRET>
CONNECTOR_TENANT_ID=<YOUR_CONNECTOR_TENANT_ID>
CONNECTOR_AUTHORITY=<YOUR_CONNECTOR_AUTHORITY>
CONNECTOR_SCOPES=<YOUR_CONNECTOR_SCOPES>
CONNECTOR_REDIRECT_URI=<YOUR_CONNECTOR_REDIRECT_URI>

# --- Operational controls ---
LOG_LEVEL=info
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_HOUR=20

# NOTE: Smart-Corp uses a PostgreSQL-backed durable queue (server/jobs.ts), so
# Redis/BullMQ is NOT required. A Redis-compatible cache (e.g. Upstash free) is an
# optional future addition, not a staging blocker.
